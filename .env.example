# Local development only. Never use these sample credentials in a hosted service.
DATABASE_URL=postgresql://tahoe:tahoe-local@127.0.0.1:55432/tahoe
# Tests use an isolated schema and roll it back/clean it up.
TEST_DATABASE_URL=postgresql://tahoe:tahoe-local@127.0.0.1:55432/tahoe
# Optional for installations whose PostgreSQL tools are not on PATH:
# POSTGRES_BIN=/Applications/Postgres.app/Contents/Versions/latest/bin
# Days of expected meetings to derive from agency schedules on export (0 disables):
# TAHOE_FORECAST_DAYS=90
# ANTHROPIC_API_KEY=
# Reader feedback (apps/web/api/feedback.js). Set the same values in the Vercel project.
# NTFY_URL is the full topic URL, e.g. https://ntfy.sh/<long-random-topic>; treat the topic name as a secret.
# NTFY_URL=
