---
import type { AgendaItem, Meeting } from '../../../../packages/domain/public';
import { citationHref, itemSourceLink, sourceDoc, timeCertainLabel, topicName } from '../lib/data';
interface Props { meeting: Meeting; item: AgendaItem; position: number; topicIds: string[]; nested: boolean }
const { meeting, item, position, topicIds: orderedTopics, nested } = Astro.props;
const sourceLink = itemSourceLink(meeting, item);
const Heading = nested ? 'h4' : 'h3';
---
<details class="agenda-item" id={`item-${item.id}`} data-agenda-item data-item-id={item.id} data-topic-ids={JSON.stringify(orderedTopics)}><summary class="agenda-accordion-summary"><span class="agenda-order"><span>{String(position).padStart(2, '0')}</span>{item.number && <small>#{item.number}</small>}</span><div class="agenda-heading"><div class="agenda-item-title"><Heading>{item.title}</Heading></div>{item.timeCertain && <span class="time-certain-badge" title={item.timeCertain.quote}>◷ {timeCertainLabel(item)}</span>}{!nested && item.section && <span class="agenda-section-name">{item.section}</span>}<div class="agenda-summary-topics" aria-label="Agenda item topics">{orderedTopics.length ? orderedTopics.map((topicId) => <span class="tag">{topicName(topicId)}</span>) : <span class="tag tag-unassigned">Not categorized</span>}</div></div><span class="agenda-disclosure" aria-hidden="true"></span></summary><div class="agenda-item-content">{orderedTopics.length > 0 && <div class="tag-row">{orderedTopics.map((topicId) => <a class="tag" href={`/topics/${encodeURIComponent(topicId)}/`}>{topicName(topicId)}</a>)}</div>}
  {item.timeCertain && <p class="time-certain-source"><strong>{timeCertainLabel(item)}.</strong> The agenda says: <q>{item.timeCertain.quote}</q>{item.timeCertain.page && ` (page ${item.timeCertain.page})`}</p>}
  {sourceLink && <a class="agenda-source-link" href={sourceLink.href} target="_blank" rel="noopener noreferrer">{sourceLink.label} ↗</a>}
  {(item.summary?.status === 'published' ? <div class="summary-block"><div class="summary-label"><span>AGENDA EXCERPT</span></div><p>{item.summary.text}</p><div class="citations">{item.summary.citations.map((citation) => { const doc = sourceDoc(meeting, citation.documentId); const href = citationHref(doc?.url ?? meeting.officialUrl, citation.page, doc?.mediaType); return <details class="citation"><summary><span class="citation-mark" aria-hidden="true">↗</span><span><strong>{doc?.title ?? 'Official source'} · {doc?.mediaType && doc.mediaType !== 'application/pdf' ? 'source section' : 'page'} {citation.page}</strong><small>View cited passage and open source</small></span></summary>{citation.quote ? <q>{citation.quote}</q> : <p class="citation-missing">The quoted passage is unavailable. Open the cited page to review the source.</p>}<a class="citation-open" href={href} target="_blank" rel="noopener noreferrer">Open official source{doc?.mediaType && doc.mediaType !== 'application/pdf' ? '' : ` on page ${citation.page}`} ↗</a></details>; })}</div></div> : <div class="empty-summary"><strong>Summary unavailable</strong><p>See the official source material below.</p></div>)}
</div></details>
