---
import type { AgendaItem, Meeting } from '../../../../packages/domain/public';
import { itemSourceLink, timeCertainLabel, topicName } from '../lib/data';
import { itemDetail } from '../lib/agenda-excerpt';
import { sameHeading } from '../lib/agenda-sections';
interface Props { meeting: Meeting; item: AgendaItem; topicIds: string[]; nested: boolean }
const { meeting, item, topicIds: orderedTopics, nested } = Astro.props;
const sourceLink = itemSourceLink(meeting, item);
const detail = itemDetail(item);
const Heading = nested ? 'h4' : 'h3';
// A standalone item names its section only when the section adds something ("Public Communications" under itself does not).
const sectionName = !nested && item.section && !sameHeading(item.title, item.section) ? item.section : null;
---
<details class="agenda-item" id={`item-${item.id}`} data-agenda-item data-item-id={item.id} data-topic-ids={JSON.stringify(orderedTopics)}><summary class="agenda-accordion-summary"><span class="agenda-order">{item.number && <span>{item.number}</span>}</span><div class="agenda-heading"><div class="agenda-item-title"><Heading>{item.title}</Heading></div>{item.timeCertain && <span class="time-certain-badge" title={item.timeCertain.quote}>◷ {timeCertainLabel(item)}</span>}{sectionName && <span class="agenda-section-name">{sectionName}</span>}{orderedTopics.length > 0 && <div class="agenda-summary-topics" aria-label="Agenda item topics">{orderedTopics.map((topicId) => <span class="tag">{topicName(topicId)}</span>)}</div>}</div><span class="agenda-disclosure" aria-hidden="true"></span></summary><div class="agenda-item-content">
  {item.timeCertain && <p class="time-certain-source"><strong>{timeCertainLabel(item)}.</strong> The agenda says: <q>{item.timeCertain.quote}</q>{item.timeCertain.page && ` (page ${item.timeCertain.page})`}</p>}
  {detail && <div class="summary-block"><div class="summary-label"><span>{detail.label.toUpperCase()}</span></div><p>{detail.text}</p></div>}
  {sourceLink ? <a class="agenda-source-link source-document" href={sourceLink.href} target="_blank" rel="noopener noreferrer"><span class="document-icon" aria-hidden="true">↗</span><span><strong>{sourceLink.label}</strong><small>{sourceLink.detail}</small></span></a> : <p class="agenda-source-missing">See the official documents below.</p>}
</div></details>
