---
// One feedback dialog per page. Open it with any [data-feedback-open] element (optional
// data-feedback-kind and data-feedback-prompt), or dispatch a `feedback:open` event.
---
<dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
  <form class="feedback-form" id="feedback-form" method="dialog" novalidate>
    <div class="feedback-head">
      <h2 id="feedback-title">Send feedback</h2>
      <button class="feedback-close" type="button" data-feedback-close aria-label="Close">×</button>
    </div>
    <p class="feedback-help" id="feedback-help">What is missing, wrong, or confusing? Suggestions shape what the site covers next.</p>
    <label class="sr-only" for="feedback-message">Your feedback</label>
    <textarea id="feedback-message" name="message" rows="7" maxlength="4000" required aria-describedby="feedback-help feedback-status"></textarea>
    <input type="hidden" name="kind" value="general" />
    <div class="feedback-trap" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
    <p class="feedback-status" id="feedback-status" role="status" aria-live="polite"></p>
    <div class="feedback-actions">
      <button class="feedback-cancel" type="button" data-feedback-close>Cancel</button>
      <button class="feedback-submit" type="submit">Send feedback</button>
    </div>
  </form>
</dialog>
<script src="../scripts/feedback-dialog.ts"></script>
