---
import type { Meeting } from '../../../../packages/domain/public';
import { agencyFor, agendaNotPosted, awaitingAgendaLabel, formatDate, isForecast, meetingAgendaLabel, meetingDateLabel, meetingDateValue, meetingHref, meetingPreviews, meetingTopicIds, residentWarning, topics } from '../lib/data';
import { meetingCardTitle } from '../lib/meeting-title';
import StatusPill from './StatusPill.astro';
const { meeting, initialTopic = '' } = Astro.props as { meeting: Meeting; initialTopic?: string };
const agency = agencyFor(meeting);
const forecast = isForecast(meeting);
const canceled = meeting.status === 'canceled' || meeting.change === 'canceled';
// A named host takes the agency's place in the title prefix.
const title = meetingCardTitle(meeting.title, meeting.host ? { name: meeting.host, shortName: meeting.host } : agency, { canceled });
// Only what is known: an unpublished location or uncounted agenda leaves no placeholder text.
const details = [meeting.location, meetingAgendaLabel(meeting)].filter(Boolean);
const label = forecast ? awaitingAgendaLabel : canceled ? 'Canceled' : meeting.status === 'rescheduled' || meeting.change === 'rescheduled' ? 'Rescheduled' : meeting.change === 'revised' ? 'Revised' : agendaNotPosted(meeting) ? awaitingAgendaLabel : '';
const tone = label === awaitingAgendaLabel ? 'outline' : label === 'Canceled' ? 'red' : label === 'Revised' || label === 'Rescheduled' ? 'amber' : 'muted';
const dateValue = meetingDateValue(meeting);
// A planned meeting's "Planned:" line already says its subjects may change, so the export warning is not repeated.
const warning = forecast ? null : meeting.warnings.map(residentWarning).filter((text) => !(meeting.planned && text === 'Subject to change.')).find(Boolean);
// An expected meeting has no page or calendar file; its card points to the agency for the real notice.
// Every planned subject is rendered; timeline-filters.ts shows the first few while no topic is selected.
// With a topic selected the line is hidden: the topic's agenda list (TopicAgendaLinks) carries the matching subjects.
const previews = meetingPreviews(meeting);
const PREVIEW_LIMIT = 3;
const shownPreviews = new Set(previews.slice(0, PREVIEW_LIMIT));
const morePreviews = previews.length - shownPreviews.size;
// Topics from the agenda, notice, and planned subjects, in catalog order; timeline-filters.ts marks the selected one.
const topicIds = meetingTopicIds(meeting);
const cardTopics = topics.filter((topic) => topicIds.includes(topic.id));
const link = forecast ? { href: meeting.officialUrl, target: '_blank', rel: 'noopener noreferrer' } : { href: meetingHref(meeting) };
---
<article class:list={['meeting-card', { 'meeting-card-canceled': canceled, 'meeting-card-forecast': forecast }]}>
  <a class="meeting-card-main" {...link}>
    <div class="meeting-date">{dateValue ? <><span class="date-day">{meetingDateLabel(meeting, { day: '2-digit' })}</span><span>{meetingDateLabel(meeting, { month: 'short' })}</span></> : <span class="date-unscheduled">Date<br />TBA</span>}</div>
    <div class="meeting-card-copy">
      <div class="eyebrow">{meeting.startsAt ? formatDate(meeting.startsAt, { weekday: 'long', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }) : dateValue ? meetingDateLabel(meeting, { weekday: 'long' }) : 'Date not announced'}</div>
      <h3>{canceled && <span class="sr-only">Canceled: </span>}{forecast && <span class="sr-only">Expected, no agenda yet: </span>}{title}</h3>
      {forecast ? <p>{meeting.forecast?.basis}<span class="sr-only"> (opens in a new tab)</span></p> : details.length > 0 && <p>{details.map((detail, index) => <>{index > 0 && <> <span class="dot">·</span> </>}{detail}</>)}</p>}
      {previews.length > 0 && <p class="meeting-previews" data-meeting-previews data-preview-limit={PREVIEW_LIMIT} hidden={Boolean(initialTopic)}><span class="meeting-previews-label">Planned:</span> {previews.map((preview) => <span class="meeting-preview" data-preview-topics={JSON.stringify(preview.topics)} hidden={!shownPreviews.has(preview)}>{preview.subject}</span>)}<span class="meeting-preview-more" data-preview-more hidden={morePreviews === 0}>and {morePreviews} more</span></p>}
      {warning && <span class="subtle">{warning}</span>}
      {cardTopics.length > 0 && <span class="meeting-topics"><span class="sr-only">Topics: </span>{cardTopics.map((topic, index) => <span class:list={['tag', 'meeting-topic', { 'meeting-topic-selected': topic.id === initialTopic }]} data-card-topic={topic.id}>{index > 0 && <span class="sr-only">, </span>}{topic.name}</span>)}</span>}
    </div>
    <span class="meeting-card-arrow" aria-hidden="true">↗</span>
  </a>
  {label && <div class="meeting-card-status"><StatusPill label={label} tone={tone} /></div>}
</article>
