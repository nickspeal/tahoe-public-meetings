---
import type { Meeting } from '../../../../packages/domain/public';
import { agencyFor, formatDate, isForecast, meetingAgendaLabel, meetingDateLabel, meetingDateValue, meetingHref, meetingStateLabel, residentWarning } from '../lib/data';
import StatusPill from './StatusPill.astro';
const { meeting } = Astro.props as { meeting: Meeting };
const agency = agencyFor(meeting);
const forecast = isForecast(meeting);
const canceled = meeting.status === 'canceled' || meeting.change === 'canceled';
const agendaLabel = meetingAgendaLabel(meeting);
const stateLabel = meetingStateLabel(meeting);
const label = forecast ? 'Expected · no agenda yet' : canceled ? 'Canceled' : meeting.status === 'rescheduled' || meeting.change === 'rescheduled' ? 'Rescheduled' : meeting.change === 'revised' ? 'Revised' : meeting.status === 'unknown' ? stateLabel : '';
const tone = forecast ? 'outline' : label === 'Canceled' ? 'red' : label === 'Revised' || label === 'Rescheduled' ? 'amber' : 'muted';
const dateValue = meetingDateValue(meeting);
const warning = forecast ? null : meeting.warnings.map(residentWarning).find(Boolean);
// An expected meeting has no page or calendar file; its card points to the agency for the real notice.
const link = forecast ? { href: meeting.officialUrl, target: '_blank', rel: 'noopener noreferrer' } : { href: meetingHref(meeting) };
---
<article class:list={['meeting-card', { 'meeting-card-canceled': canceled, 'meeting-card-forecast': forecast }]}>
  <a class="meeting-card-main" {...link}>
    <div class="meeting-date">{dateValue ? <><span class="date-day">{meetingDateLabel(meeting, { day: '2-digit' })}</span><span>{meetingDateLabel(meeting, { month: 'short' })}</span></> : <span class="date-unscheduled">Date<br />TBA</span>}</div>
    <div class="meeting-card-copy">
      <div class="eyebrow">{agency?.shortName ?? 'Agency'} <span class="dot">·</span> {meeting.startsAt ? formatDate(meeting.startsAt, { weekday: 'long', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }) : dateValue ? `${meetingDateLabel(meeting, { weekday: 'long' })} · Time not announced` : 'Date not announced'}</div>
      <h3>{canceled && <span class="sr-only">Canceled: </span>}{forecast && <span class="sr-only">Expected, no agenda yet: </span>}{meeting.title}</h3>
      {forecast ? <p>{meeting.forecast?.basis} <span class="dot">·</span> Check the agency website<span class="sr-only"> (opens in a new tab)</span></p> : <p>{meeting.location ?? 'Location not yet published'} <span class="dot">·</span> {agendaLabel}</p>}
      {warning && <span class="subtle">{warning}</span>}
    </div>
    <span class="meeting-card-arrow" aria-hidden="true">↗</span>
  </a>
  {label && <div class="meeting-card-status"><StatusPill label={label} tone={tone} /></div>}
</article>
