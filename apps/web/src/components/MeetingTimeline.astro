---
import type { Meeting } from '../../../../packages/domain/public';
import FilterCombobox from './FilterCombobox.astro';
import TimelineRow from './TimelineRow.astro';
import { agencySearchTerms, topicSearchTerms } from '../lib/filter-terms';
import { allItems, awaitingAgenda, meetingTopicIds, data, forecastMeetings, formatDate, isForecast, meetings, topics } from '../lib/data';
const { initialTopic = '' } = Astro.props as { initialTopic?: string };
// Not a filter: choosing it opens the feedback dialog (timeline-filters.ts).
const SUGGEST_TOPIC = '__suggest';
// The site is a static snapshot: this is the build's today. timeline-filters.ts moves the marker if the reader's Lake Tahoe date is later.
const today = new Date();
function dateKey(value: string | Date) {
  if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date(value));
  const part = (type: Intl.DateTimeFormatPartTypes) => parts.find((entry) => entry.type === type)?.value ?? '';
  return `${part('year')}-${part('month')}-${part('day')}`;
}
function meetingDateValue(meeting: Meeting) { return meeting.startsAt ?? meeting.date ?? null; }
const todayKey = dateKey(today);
// Expected meetings are never history: a forecast that has passed since export is dropped.
const expected = forecastMeetings.filter((meeting) => meetingDateValue(meeting) && dateKey(meetingDateValue(meeting)!) >= todayKey);
const active = [...meetings, ...expected];
const byDateThenStart = (a: Meeting, b: Meeting) => dateKey(meetingDateValue(a)!).localeCompare(dateKey(meetingDateValue(b)!)) || +new Date(a.startsAt ?? a.updatedAt) - +new Date(b.startsAt ?? b.updatedAt);
const earlier = meetings.filter((meeting) => meetingDateValue(meeting) && dateKey(meetingDateValue(meeting)!) < todayKey).sort(byDateThenStart);
const todayMeetings = active.filter((meeting) => meetingDateValue(meeting) && dateKey(meetingDateValue(meeting)!) === todayKey).sort((a, b) => +new Date(a.startsAt ?? a.updatedAt) - +new Date(b.startsAt ?? b.updatedAt));
const future = active.filter((meeting) => meetingDateValue(meeting) && dateKey(meetingDateValue(meeting)!) > todayKey).sort(byDateThenStart);
const undated = meetings.filter((meeting) => !meetingDateValue(meeting)).sort((a, b) => +new Date(b.updatedAt) - +new Date(a.updatedAt));
function groupByDate(rows: Meeting[]) {
  const groups = new Map<string, Meeting[]>();
  for (const meeting of rows) {
    const key = dateKey(meetingDateValue(meeting)!);
    groups.set(key, [...(groups.get(key) ?? []), meeting]);
  }
  return [...groups.entries()];
}
function dateHeading(key: string) {
  return formatDate(new Date(`${key}T12:00:00-07:00`), { weekday: 'long', month: 'long', day: 'numeric' });
}
const topicMatches = (meeting: Meeting, topicId: string) => meetingTopicIds(meeting).includes(topicId);
const filtered = (meeting: Meeting) => !initialTopic || topicMatches(meeting, initialTopic);
// Mirrors the default view in timeline-filters.ts: earlier meetings and upcoming ones without an agenda start hidden.
const rowHidden = (meeting: Meeting, bucket: string) => !filtered(meeting) || bucket === 'earlier' || awaitingAgenda(meeting);
const groupHidden = (rows: Meeting[], bucket: string) => rows.length > 0 && rows.every((meeting) => rowHidden(meeting, bucket));
const upcoming = [...todayMeetings, ...future, ...undated].filter(filtered);
const initialShown = upcoming.filter((meeting) => !awaitingAgenda(meeting));
const initialCount = initialShown.length;
const initialAwaiting = upcoming.length - initialShown.length;
const initialExpected = upcoming.filter(isForecast).length;
const initialEarlierCount = earlier.filter(filtered).length;
const initialAgendaCount = initialTopic ? initialShown.reduce((total, meeting) => total + allItems(meeting).filter((item) => item.topics.includes(initialTopic)).length, 0) : 0;
const initialUpcomingCount = initialShown.filter((meeting) => meeting.status !== 'canceled' && meeting.change !== 'canceled').length;
const earlierGroups = groupByDate(earlier);
const step = 10;
const awaitingLabel = (count: number) => `Show ${count} upcoming ${count === 1 ? 'meeting' : 'meetings'} without a posted agenda`;
const expectedHint = (count: number) => count ? `Includes ${count} expected from each agency’s usual schedule` : '';
const meetingAgencyIds = new Set(meetings.map((meeting) => meeting.agencyId));
const meetingAgencies = data.agencies.filter((agency) => meetingAgencyIds.has(agency.id));
---
<section class="timeline-page">
  <div class="timeline-head section-wrap">
    <form class="timeline-filters" aria-label="Filter meetings">
      <FilterCombobox id="topic-filter" name="topic" label="Topic" allLabel="All topics" noun="topics" selected={initialTopic} options={[
        ...topics.map((topic) => ({ value: topic.id, label: topic.name, terms: topicSearchTerms(topic) })),
        { value: SUGGEST_TOPIC, label: 'Suggest a topic…', always: true, data: { 'feedback-kind': 'topic', 'feedback-prompt': "I'm interested in adding a new topic: " } },
      ]} />
      <FilterCombobox id="agency-filter" name="agency" label="Agency" allLabel="All agencies" noun="agencies" options={meetingAgencies.map((agency) => ({ value: agency.id, label: agency.name, terms: agencySearchTerms(agency) }))} />
      <a class="clear-filters" id="clear-filters" href="/">Clear filters</a>
    </form>
  </div>
  <div class="timeline-count section-wrap"><span id="timeline-count" aria-live="polite">{initialCount} {initialCount === 1 ? 'meeting' : 'meetings'}{initialTopic ? ` · ${topics.find((topic) => topic.id === initialTopic)?.name}` : ''}</span><span id="agenda-count">{initialTopic ? `${initialAgendaCount} related agenda ${initialAgendaCount === 1 ? 'item' : 'items'}` : ''}</span><a class="today-jump" href="#today-divider">Today ↓</a></div>
  <div class="timeline section-wrap" id="meeting-timeline">
    <div class="earlier-meetings" id="earlier-meetings" data-step={step} hidden={initialEarlierCount === 0}>
      <button type="button" class="timeline-more" id="earlier-more" aria-controls="earlier-list"><span id="earlier-more-label">Show {Math.min(step, initialEarlierCount)} earlier {Math.min(step, initialEarlierCount) === 1 ? 'meeting' : 'meetings'}</span><span class="timeline-more-count" id="earlier-remaining">{initialEarlierCount} earlier</span></button>
      <a class="timeline-more timeline-jump" id="earlier-today-jump" href="#today-divider" hidden>Scroll to today</a>
      <div class="earlier-list" id="earlier-list">{earlierGroups.map(([key, rows]) => <section class="timeline-date-group earlier-date-group" data-timeline-group={`earlier-${key}`} data-date={key} hidden><h2>{dateHeading(key)}</h2><div class="timeline-meeting-list">{rows.map((meeting) => <TimelineRow meeting={meeting} dateKey={key} bucket="earlier" initialTopic={initialTopic} hidden />)}</div></section>)}</div>
    </div>
    <div class="today-divider" id="today-divider" data-today={todayKey}><span class="today-label">TODAY</span><time>{formatDate(today, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</time></div>
    <section class="timeline-date-group" data-timeline-group="today" hidden={groupHidden(todayMeetings, 'today')}><h2>Today</h2><div class="timeline-meeting-list">{todayMeetings.map((meeting) => <TimelineRow meeting={meeting} dateKey={todayKey} bucket="today" initialTopic={initialTopic} hidden={rowHidden(meeting, 'today')} />)}</div>{todayMeetings.length === 0 && <p class="timeline-empty-inline" data-today-empty>No meetings scheduled today.</p>}</section>
    {groupByDate(future).map(([key, rows]) => <section class="timeline-date-group" data-timeline-group={`future-${key}`} data-date={key} hidden={groupHidden(rows, 'upcoming')}><h2>{dateHeading(key)}</h2><div class="timeline-meeting-list">{rows.map((meeting) => <TimelineRow meeting={meeting} dateKey={key} bucket="upcoming" initialTopic={initialTopic} hidden={rowHidden(meeting, 'upcoming')} />)}</div></section>)}
    {undated.length > 0 && <section class="timeline-date-group" data-timeline-group="undated" hidden={groupHidden(undated, 'undated')}><h2>Date to be announced</h2><div class="timeline-meeting-list">{undated.map((meeting) => <TimelineRow meeting={meeting} bucket="undated" initialTopic={initialTopic} hidden={rowHidden(meeting, 'undated')} />)}</div></section>}
    <p class="timeline-empty-future" id="no-upcoming-message" hidden={initialUpcomingCount > 0 || initialCount + initialAwaiting + initialEarlierCount === 0}>{initialTopic ? `No upcoming agendas match ${topics.find((topic) => topic.id === initialTopic)?.name} yet.` : 'No upcoming agendas are posted yet.'}</p>
    <div class="upcoming-more" id="upcoming-more" hidden={initialAwaiting === 0}>
      <button type="button" class="timeline-more" id="upcoming-toggle" aria-expanded="false"><span id="upcoming-toggle-label">{awaitingLabel(initialAwaiting)}</span></button>
      <p class="timeline-more-hint" id="upcoming-hint">{expectedHint(initialExpected)}</p>
    </div>
    <div class="timeline-no-results" id="timeline-no-results" hidden={initialCount + initialAwaiting + initialEarlierCount > 0}><h2>No meetings match these filters</h2><p>Try another topic or agency.</p></div>
  </div>
  <script src="../scripts/timeline-filters.ts"></script>
</section>
