---
import { agencies, commentPeriods, formatDate, topicName } from '../lib/data';
const { all = false } = Astro.props;
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const isClosed = (period: typeof commentPeriods[number]) => period.closesAt ? new Date(period.closesAt).valueOf() < Date.now() : period.closesOn < today;
const periods = commentPeriods.filter((period) => all || !isClosed(period));
const dayLabel = (value: string) => formatDate(`${value}T12:00:00-08:00`, { month: 'long', day: 'numeric', year: 'numeric' });
---
<section class="section-wrap content-section comment-periods" aria-labelledby="comment-period-title">
  <p class="eyebrow">PUBLIC PARTICIPATION</p>
  <h2 id="comment-period-title">Public comment periods</h2>
  <p>Submit comments on projects and proposals during the agency’s published comment window. These opportunities are separate from scheduled meetings.</p>
  {periods.length ? <div class="comment-period-list">{periods.map((period) => <article class="aside-card comment-period" id={period.id}>
    <p class="eyebrow">{agencies.find((a) => a.id === period.agencyId)?.name ?? period.agencyId}</p>
    <h3><a href={period.officialUrl} target="_blank" rel="noopener noreferrer">{period.title} ↗</a></h3>
    <p><strong>{isClosed(period) ? 'Closed' : 'Comments due'} {period.closesAt ? formatDate(period.closesAt, { month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }) : dayLabel(period.closesOn)}</strong>{!period.closesAt && <span> · Exact closing time not stated</span>}</p>
    {period.opensOn && <p>Comment window: {dayLabel(period.opensOn)}–{dayLabel(period.closesOn)}</p>}
    {period.topics.length > 0 && <div class="tag-row">{period.topics.map((topic) => <a class="tag" href={`/topics/${encodeURIComponent(topic)}/`}>{topicName(topic)}</a>)}</div>}
    <p>{period.instructions ?? 'Check the official notice for submission methods and requirements.'}</p>
    <details><summary>Source notice</summary><blockquote>{period.sourceQuote}</blockquote><a href={period.officialUrl} target="_blank" rel="noopener noreferrer">Open official notice ↗</a><p class="subtle">Checked {formatDate(period.lastCheckedAt)}</p></details>
    {period.participationUrl && <p><a class="button button-outline" href={period.participationUrl} target="_blank" rel="noopener noreferrer">Comment instructions ↗</a></p>}
  </article>)}</div> : <p class="muted-panel">No verified {all ? '' : 'open or upcoming '}public comment periods are listed yet.</p>}
  {!all && commentPeriods.some(isClosed) && <p><a href="/comment-periods/">View past comment periods</a></p>}
</section>
