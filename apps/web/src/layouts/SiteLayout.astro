---
import '../styles/global.css';
import FeedbackDialog from '../components/FeedbackDialog.astro';
import { data, formatDate } from '../lib/data';
import { analyticsConfig, GOATCOUNTER_SCRIPT } from '../lib/analytics';
const { title = 'Tahoe Public Meetings', description = 'Follow the local decisions shaping life around Lake Tahoe.', noindex = false } = Astro.props;
// Absolute canonical URL on the production origin (astro.config.mjs `site`), so www and preview hosts point at the apex.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
// Link preview image (source: scripts/og-image.html). Crawlers need an absolute URL.
const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url).href;
// The home page's own title is "Meetings", which reads poorly as a shared link's headline.
const ogTitle = Astro.url.pathname === '/' ? 'Tahoe Public Meetings' : `${title} · Tahoe Public Meetings`;
// GoatCounter loads only in Production builds (PUBLIC_GOATCOUNTER_URL). Filter state is counted as events, so a
// pageview records the path alone: no query string, and not the canonical URL count.js would otherwise use.
const analytics = analyticsConfig(import.meta.env);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ed" />
    <title>{title} · Tahoe Public Meetings</title>
    {noindex ? <meta name="robots" content="noindex" /> : canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tahoe Public Meetings" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tahoe Public Meetings: what's on the agenda around Lake Tahoe" />
    <meta name="twitter:card" content="summary_large_image" />
    {analytics && <script is:inline>window.goatcounter = { path: function () { return location.pathname; } };</script>}
    {analytics && <script is:inline async data-goatcounter={analytics.endpoint} src={GOATCOUNTER_SCRIPT.src} integrity={GOATCOUNTER_SCRIPT.integrity} crossorigin="anonymous"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Tahoe Public Meetings home">
          <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M4 29 15 12l7 10 5-7 9 14H4Z"/><path d="M8 33h24"/></svg></span>
          <span class="brand-name">Tahoe <strong>Public Meetings</strong></span>
        </a>
        <nav aria-label="Main navigation" class="primary-nav">
          <a href="/meetings/">Meetings</a>
          <a href="/comment-periods/">Public Comment Periods</a>
          <button class="nav-feedback" type="button" data-feedback-open>Feedback</button>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <FeedbackDialog />
    <footer class="site-footer">
      <div class="footer-inner">
        <div><a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M4 29 15 12l7 10 5-7 9 14H4Z"/><path d="M8 33h24"/></svg></span><span class="brand-name">Tahoe <strong>Public Meetings</strong></span></a></div>
        <nav class="footer-links" aria-label="Site information"><a href="/about/">About</a><a href="/coverage/">Coverage</a><a href="/privacy/">Privacy</a><button class="footer-feedback" type="button" data-feedback-open>Send feedback</button></nav>
      </div>
      <p class="data-freshness">Meeting data updated <time datetime={data.generatedAt} data-generated-at>{formatDate(data.generatedAt, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' })}</time><span data-generated-ago></span></p>
    </footer>
    <script>
      const stamp = document.querySelector<HTMLTimeElement>('[data-generated-at]');
      const ago = document.querySelector<HTMLElement>('[data-generated-ago]');
      const hours = stamp ? (Date.now() - Date.parse(stamp.dateTime)) / 3_600_000 : NaN;
      if (ago && Number.isFinite(hours) && hours >= 0) {
        ago.textContent = hours < 1 ? ' (less than an hour ago)' : hours < 48 ? ` (${Math.floor(hours)} hours ago)` : ` (${Math.floor(hours / 24)} days ago)`;
        if (hours > 24) ago.closest('.data-freshness')?.classList.add('is-stale');
      }
    </script>
  </body>
</html>
