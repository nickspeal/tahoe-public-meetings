---
import SiteLayout from '../layouts/SiteLayout.astro';
import { agencySourceLabel, data, meetingDateValue, meetings } from '../lib/data';
const dated = meetings.flatMap((meeting) => {
  const value = meetingDateValue(meeting);
  if (!value) return [];
  return [typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value) ? new Date(`${value}T12:00:00-08:00`) : new Date(value)];
}).sort((a, b) => a.valueOf() - b.valueOf());
const dateRange = dated.length ? `${dated[0].toLocaleDateString('en-US', { timeZone: 'America/Los_Angeles', month: 'long', year: 'numeric' })}–${dated.at(-1)!.toLocaleDateString('en-US', { timeZone: 'America/Los_Angeles', month: 'long', year: 'numeric' })}` : 'No dated meeting records';
const documentCount = meetings.reduce((sum, meeting) => sum + meeting.documents.length, 0);
---
<SiteLayout title="About" description="Coverage and sources for Tahoe Public Meetings.">
  <section class="page-hero compact"><div class="section-wrap"><p class="eyebrow">SITE INFORMATION</p><h1>About</h1><p class="page-intro">Meeting notices and agenda records gathered from public agency sources around Lake Tahoe.</p></div></section>
  <section class="section-wrap content-section about-content">
    <div class="about-grid">
      <article id="coverage"><p class="eyebrow">COVERAGE</p><h2>Records currently listed</h2><p>{meetings.length} meetings from {new Set(meetings.map((meeting) => meeting.agencyId)).size} agencies, with {documentCount} linked source {documentCount === 1 ? 'document' : 'documents'}. Dated records span {dateRange}.</p><p>Agency schedules can change. Confirm meeting time, location, access, and participation instructions on the official meeting page before attending or acting.</p></article>
      <article><p class="eyebrow">SOURCES</p><h2>Official pages and documents</h2><p>Meeting details link to the agency event page and available agenda documents. Cited passages link to the relevant source page. Some records may have only agenda text; open the packet for supporting reports.</p><p>Agenda excerpts are drawn from text in linked official documents. They are automated and not human reviewed unless stated otherwise. An agenda item is not a record of a final decision.</p></article>
    </div>
    <section class="agency-coverage"><p class="eyebrow">AGENCY SOURCES</p><ul>{data.agencies.map((agency) => <li><div><h3>{agency.name}</h3><p>{agencySourceLabel(agency)}</p></div><a href={agency.sourceUrl} target="_blank" rel="noopener noreferrer">Agency meeting source ↗</a></li>)}</ul></section>
    <div class="correction-guide" id="corrections"><p class="eyebrow">ERRORS</p><h2>Spotted a mistake?</h2><p>Use <button class="inline-feedback" type="button" data-feedback-open>Send feedback</button> to report an error, ask for a topic or agency, or suggest an improvement. Feedback goes to the maintainer and is not published. For current meeting information, use the official agency source.</p></div>
  </section>
</SiteLayout>
