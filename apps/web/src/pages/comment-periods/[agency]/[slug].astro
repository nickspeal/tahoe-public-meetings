---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import StatusPill from '../../../components/StatusPill.astro';
import { agencies, commentDeadlineLabel, commentPeriodHref, commentPeriodStatus, commentPeriods, formatDate, noticeDayLabel, topicHref, topicName } from '../../../lib/data';
export function getStaticPaths() {
  // Params come from the same href the index links to, so the two cannot drift apart.
  return commentPeriods.map((period) => {
    const [, agency, slug] = commentPeriodHref(period).split('/').filter(Boolean).map(decodeURIComponent);
    return { params: { agency, slug }, props: { period } };
  });
}
const { period } = Astro.props;
const agency = agencies.find((row) => row.id === period.agencyId);
const status = commentPeriodStatus(period);
const statusLabel = status === 'closed' ? 'Closed' : status === 'upcoming' ? 'Not yet open' : 'Open for comment';
const statusTone = status === 'closed' ? 'muted' : status === 'upcoming' ? 'amber' : 'green';
const longDate = { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' } as const;
const deadline = commentDeadlineLabel(period, longDate);
---
<SiteLayout title={period.title} description={`Public comment period: ${period.title}. ${status === 'closed' ? 'Closed' : 'Comments due'} ${commentDeadlineLabel(period)}.`}>
  <section class="meeting-detail-hero"><div class="section-wrap">
    <a class="back-link" href="/comment-periods/">← All comment periods</a>
    <div class="meeting-title-line"><div><p class="eyebrow">{agency?.name ?? period.agencyId}</p><h1>{period.title}</h1>{period.topics.length > 0 && <div class="tag-row" aria-label="Topics">{period.topics.map((topic) => <a class="tag" href={topicHref(topic)}>{topicName(topic)}</a>)}</div>}</div><StatusPill label={statusLabel} tone={statusTone} /></div>
    <p class="meeting-time">{status === 'closed' ? `Closed ${deadline}` : `Comments due ${deadline}`}</p>
    <div class="meeting-hero-meta"><a href={period.officialUrl} target="_blank" rel="noopener noreferrer">Official notice ↗</a></div>
    {status === 'closed' && <div class="warning-note"><p>This comment period has closed. The notice and its instructions are kept here as a record.</p></div>}
  </div></section>
  <section class="section-wrap detail-layout">
    <div class="detail-main">
      <section class="comment-period-section" aria-labelledby="how-to-comment">
        <div class="content-heading"><p class="eyebrow">{status === 'closed' ? 'AS PUBLISHED' : 'SUBMIT A COMMENT'}</p><h2 id="how-to-comment">How to comment</h2></div>
        <p class="comment-period-instructions">{period.instructions ?? 'The notice does not state submission methods here. Check the official notice for how to comment.'}</p>
      </section>
      <section class="source-list-block" aria-labelledby="official-notice">
        <div class="content-heading"><p class="eyebrow">OFFICIAL SOURCE</p><h2 id="official-notice">From the official notice</h2><p>The comment window above is taken from this passage.</p></div>
        <blockquote class="comment-period-quote">{period.sourceQuote}</blockquote>
        <a class="source-document" href={period.officialUrl} target="_blank" rel="noopener noreferrer"><span class="document-icon" aria-hidden="true">↗</span><span><strong>Official notice</strong><small>{agency?.name ?? period.agencyId}</small></span><span class="source-open">Open official notice ↗</span></a>
      </section>
    </div>
    <aside class="detail-aside">
      <section class="aside-card"><p class="eyebrow">KEY DATES</p><h2>Comment window</h2>
        <dl class="logistics-list">
          <div><dt>Opens</dt><dd>{period.opensOn ? noticeDayLabel(period.opensOn, longDate) : 'Not stated in the notice'}</dd></div>
          <div><dt>{status === 'closed' ? 'Closed' : 'Comments due'}</dt><dd>{deadline}{!period.closesAt && <><br /><small class="comment-period-note">Exact closing time not stated</small></>}</dd></div>
          <div><dt>Agency</dt><dd>{agency ? <a href={agency.officialUrl} target="_blank" rel="noopener noreferrer">{agency.name} ↗</a> : period.agencyId}</dd></div>
        </dl>
        {status !== 'closed' && (period.participationUrl ? <a class="button button-dark button-full" href={period.participationUrl} target="_blank" rel="noopener noreferrer">Comment instructions ↗</a> : <a class="button button-outline button-full" href={period.officialUrl} target="_blank" rel="noopener noreferrer">Check the official notice ↗</a>)}
        <p class="aside-footnote">Dates and instructions are copied from the official notice.{status !== 'closed' && ' Confirm them with the agency before submitting.'}</p>
      </section>
      <section class="aside-card"><p class="eyebrow">SOURCE STATUS</p><h2>Record updated {formatDate(period.updatedAt)}</h2><p class="history-note">Official notice last checked {formatDate(period.lastCheckedAt)}.</p></section>
    </aside>
  </section>
</SiteLayout>
