---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StatusPill from '../../components/StatusPill.astro';
import CalendarDownload from '../../components/CalendarDownload.astro';
import AgendaItemCard from '../../components/AgendaItemCard.astro';
import { agendaGroups, displayedItems } from '../../lib/agenda-sections';
import { agendaAvailability, agendaHistory, agendaSourceNote, agendaHistoryHeading, agencies, documentFetchLabel, documentStatusLabel, formatDate, meetingDateLabel, meetingDateValue, meetingStateLabel, meetings, residentWarning, sourceCheckLabel, topics } from '../../lib/data';
export function getStaticPaths() { return meetings.map((meeting) => ({ params: { id: meeting.id }, props: { meeting } })); }
const { meeting } = Astro.props;
const agency = agencies.find((row) => row.id === meeting.agencyId);
const groups = agendaGroups(meeting);
const items = displayedItems(groups);
const numbered = items.some((item) => item.number);
const sectionCount = groups.filter((group) => group.name).length;
const groupTopics = (groupItems: typeof items) => topics.filter((topic) => groupItems.some((item) => item.topics.includes(topic.id)));
const itemCount = (count: number) => `${count} ${count === 1 ? 'item' : 'items'}`;
const topicCounts = new Map<string, number>();
for (const item of items) for (const topicId of item.topics) topicCounts.set(topicId, (topicCounts.get(topicId) ?? 0) + 1);
const noticeTopics = topics.filter((topic) => meeting.topics?.includes(topic.id));
const meetingTopics = topics.filter((topic) => topicCounts.has(topic.id));
const topicOrder = new Map(topics.map((topic, index) => [topic.id, index]));
const itemTopicIds = new Map(items.map((item) => [item.id, [...item.topics].sort((a, b) => (topicOrder.get(a) ?? Number.MAX_SAFE_INTEGER) - (topicOrder.get(b) ?? Number.MAX_SAFE_INTEGER) || a.localeCompare(b))]));
const state = meetingStateLabel(meeting);
const stateTone = meeting.status === 'canceled' ? 'red' : meeting.status === 'rescheduled' ? 'amber' : 'outline';
const when = meeting.startsAt ? formatDate(meeting.startsAt, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : meetingDateValue(meeting) ? meetingDateLabel(meeting, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) : 'Date and time not published';
const warnings = meeting.warnings.map(residentWarning).filter(Boolean);
const availability = agendaAvailability(meeting);
const history = agendaHistory(meeting);
const sourceNote = agendaSourceNote(meeting);
---
<SiteLayout title={meeting.title} description={`Meeting information and agenda for ${meeting.title}`}>
  <section class="meeting-detail-hero"><div class="section-wrap"><a class="back-link" href="/meetings/">← All meetings</a><div class="meeting-title-line"><div><p class="eyebrow">{agency?.name ?? 'Agency information not available'}</p><h1>{meeting.title}</h1>{noticeTopics.length > 0 && <div class="tag-row" aria-label="Meeting notice topics">{noticeTopics.map((topic) => <a class="tag" href={`/topics/${topic.id}/`}>{topic.name}</a>)}</div>}</div>{state && <StatusPill label={state} tone={stateTone} />}</div><p class="meeting-time">{when}</p><div class="meeting-hero-meta">{meeting.location && <span>◷ &nbsp;{meeting.location}</span>}<a href={meeting.officialUrl} target="_blank" rel="noopener noreferrer">Official meeting page ↗</a></div>{warnings.length > 0 && <div class="warning-note">{warnings.map((warning) => <p>{warning}</p>)}</div>}</div></section>
  <section class="section-wrap detail-layout">
    <div class="detail-main">
      {items.length > 0 && <h2 class="sr-only">Agenda</h2>}
      {items.length > 0 && <fieldset class="agenda-topic-filter" id="agenda-topic-filter"><legend>Filter agenda items by topic</legend>{meetingTopics.length ? <><p class="agenda-filter-help">Select one or more topics; items matching any selected topic are shown.</p><div class="agenda-topic-options">{meetingTopics.map((topic) => <label class="agenda-topic-option"><input type="checkbox" name="topic" value={topic.id} /><span>{topic.name}</span><small>{topicCounts.get(topic.id)}</small></label>)}</div></> : <p class="agenda-filter-empty">No agenda topics are tagged on this meeting.</p>}<div class="agenda-filter-footer"><p id="agenda-filter-count" aria-live="polite">Showing {items.length} of {items.length} agenda items</p><button class="agenda-filter-reset" type="button" id="agenda-filter-reset">All items</button></div><p class="agenda-deep-link-note" id="agenda-deep-link-note" role="status" hidden>The linked agenda item is shown outside the selected topics.</p></fieldset>}
      {items.length ? <div class={numbered ? 'agenda-items' : 'agenda-items agenda-unnumbered'} id="agenda-items">{sectionCount > 1 && <div class="agenda-section-controls"><button type="button" class="agenda-section-toggle" data-section-toggle="open">Expand all sections</button><button type="button" class="agenda-section-toggle" data-section-toggle="close">Collapse all sections</button></div>}{groups.map((group) => group.name ? <details class="agenda-section" open data-agenda-section id={group.headingItemId ? `item-${group.headingItemId}` : undefined}><summary class="agenda-section-summary"><span class="agenda-section-heading"><h3>{group.name}</h3><span class="agenda-section-meta">{group.number && <span>#{group.number}</span>}<span data-section-count={group.items.length}>{itemCount(group.items.length)}</span></span>{groupTopics(group.items).length > 0 && <span class="agenda-section-topics" aria-label="Topics in this section">{groupTopics(group.items).map((topic) => <span class="tag">{topic.name}</span>)}</span>}</span><span class="agenda-disclosure" aria-hidden="true"></span></summary><div class="agenda-section-items">{group.items.map((item) => { const nested = true; return <AgendaItemCard meeting={meeting} item={item} topicIds={itemTopicIds.get(item.id) ?? []} nested={nested} />; })}</div></details> : group.items.map((item) => { const nested = false; return <AgendaItemCard meeting={meeting} item={item} topicIds={itemTopicIds.get(item.id) ?? []} nested={nested} />; }))}</div> : <div class="empty-panel" data-agenda-availability={availability.kind}><div class="empty-mark">≡</div><div><h2>{availability.heading}</h2><p>{availability.body}</p>{availability.href && <p><a href={availability.href} target="_blank" rel="noopener noreferrer">{availability.linkText} ↗</a></p>}</div></div>}
      <div class="source-list-block"><div class="content-heading"><p class="eyebrow">OFFICIAL DOCUMENTS</p><h2>Source material</h2></div>{meeting.documents.length ? meeting.documents.map((doc) => <a class="source-document" href={doc.url} target="_blank" rel="noopener noreferrer"><span class="document-icon" aria-hidden="true">↗</span><span><strong>{doc.title}</strong><small>{doc.pageCount} {doc.mediaType && doc.mediaType !== 'application/pdf' ? 'source sections' : 'pages'} · {documentFetchLabel(doc.fetchedAt)} · {documentStatusLabel(doc.status)}</small>{doc.warnings.map(residentWarning).filter(Boolean).map((warning) => <small class="source-warning">{warning}</small>)}</span><span class="source-open">Open official document ↗</span></a>) : <p class="muted-panel">Open the official meeting page for available agenda documents.</p>}</div>
    </div>
    <aside class="detail-aside">
      <section class="aside-card"><p class="eyebrow">ATTEND & PARTICIPATE</p><h2>Participation details</h2><dl class="logistics-list"><div><dt>Location</dt><dd>{meeting.location ?? 'Not published'}</dd></div><div><dt>Remote access</dt><dd>{meeting.participation.remoteUrl || meeting.participation.phone ? <>{meeting.participation.remoteUrl && <a href={meeting.participation.remoteUrl} target="_blank" rel="noopener noreferrer">Join remotely ↗</a>}{meeting.participation.remoteUrl && meeting.participation.phone && <br />}{meeting.participation.phone && <>By phone: {meeting.participation.phone}</>}</> : 'Not published'}</dd></div>{meeting.participation.watchUrl && <div><dt>Watch live</dt><dd><a href={meeting.participation.watchUrl} target="_blank" rel="noopener noreferrer">Livestream ↗</a></dd></div>}<div><dt>Public comment</dt><dd>{meeting.participation.instructions ?? 'Official instructions not available.'}{meeting.participation.email && <><br />Written comment: <a href={`mailto:${meeting.participation.email}`}>{meeting.participation.email}</a></>}</dd></div><div><dt>Deadline</dt><dd>{meeting.participation.deadline ?? 'No deadline stated'}</dd></div></dl><CalendarDownload meeting={meeting} />{meeting.participation.url ? <a class="button button-dark button-full" href={meeting.participation.url} target="_blank" rel="noopener noreferrer">Participation details ↗</a> : <a class="button button-outline button-full" href={meeting.officialUrl} target="_blank" rel="noopener noreferrer">Check agency website ↗</a>}<p class="aside-footnote">{meeting.participation.fromAgenda ? 'Read automatically from the official agenda. ' : ''}Confirm current instructions with the agency.</p></section>
      <section class="aside-card record-card"><p class="eyebrow">AFTER THE MEETING</p><h2>The public record</h2><div class="record-link"><span>Minutes</span>{meeting.minutesUrl ? <span class="record-value"><a href={meeting.minutesUrl} target="_blank" rel="noopener noreferrer">{meeting.minutesStatus === 'draft' ? 'Read draft minutes ↗' : 'Read minutes ↗'}</a>{meeting.minutesNote && <small>{meeting.minutesNote}</small>}</span> : <span class="record-missing">Not yet available</span>}</div><div class="record-link"><span>Recording</span>{meeting.recordingUrl ? <a href={meeting.recordingUrl} target="_blank" rel="noopener noreferrer">Watch recording ↗</a> : <span class="record-missing">Not yet available</span>}</div></section>
      {history ? <section class="aside-card agenda-history"><p class="eyebrow">AGENDA HISTORY</p><h2>{agendaHistoryHeading(history)}</h2>{history.length > 0 && <ol class="history-list">{history.map((entry) => <li class={`history-${entry.change}`}><time datetime={entry.at}>{formatDate(entry.at, { month: 'short', day: 'numeric', year: 'numeric' })}</time><span>{entry.text}</span></li>)}</ol>}{sourceNote && <p class="history-note history-source-note">{sourceNote}</p>}<p class="history-note">{history.length > 0 && 'Dates are when this site first found each version, which can be later than when the agency posted it. '}{sourceCheckLabel(meeting.lastCheckedAt)}.</p></section>
      : <section class="aside-card agenda-history"><p class="eyebrow">SOURCE STATUS</p><h2>Meeting record updated {formatDate(meeting.updatedAt)}</h2>{sourceNote && <p class="history-note history-source-note">{sourceNote}</p>}<p class="history-note">{sourceCheckLabel(meeting.lastCheckedAt)}.</p></section>}
    </aside>
  </section>
  <script src="../../scripts/meeting-agenda-filter.ts"></script>
  <script src="../../scripts/open-agenda-item.ts"></script>
</SiteLayout>
