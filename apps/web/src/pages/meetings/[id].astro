---
import SiteLayout from '../../layouts/SiteLayout.astro';
import StatusPill from '../../components/StatusPill.astro';
import CalendarDownload from '../../components/CalendarDownload.astro';
import { agendaAvailability, agendaHistory, agendaHistoryHeading, allItems, agencies, citationHref, documentFetchLabel, documentStatusLabel, formatDate, itemSourceLink, meetingDateLabel, meetingDateValue, meetingStateLabel, meetings, residentWarning, sourceCheckLabel, sourceDoc, timeCertainLabel, topicName, topics } from '../../lib/data';
export function getStaticPaths() { return meetings.map((meeting) => ({ params: { id: meeting.id }, props: { meeting } })); }
const { meeting } = Astro.props;
const agency = agencies.find((row) => row.id === meeting.agencyId);
const items = allItems(meeting);
const topicCounts = new Map<string, number>();
for (const item of items) for (const topicId of item.topics) topicCounts.set(topicId, (topicCounts.get(topicId) ?? 0) + 1);
const noticeTopics = topics.filter((topic) => meeting.topics?.includes(topic.id));
const meetingTopics = topics.filter((topic) => topicCounts.has(topic.id));
const topicOrder = new Map(topics.map((topic, index) => [topic.id, index]));
const itemTopicIds = new Map(items.map((item) => [item.id, [...item.topics].sort((a, b) => (topicOrder.get(a) ?? Number.MAX_SAFE_INTEGER) - (topicOrder.get(b) ?? Number.MAX_SAFE_INTEGER) || a.localeCompare(b))]));
const state = meetingStateLabel(meeting);
const stateTone = meeting.status === 'canceled' ? 'red' : meeting.status === 'rescheduled' ? 'amber' : state === 'Scheduled' ? 'green' : 'muted';
const when = meeting.startsAt ? formatDate(meeting.startsAt, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }) : meetingDateValue(meeting) ? `${meetingDateLabel(meeting, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })} · Time not announced` : 'Date and time not published';
const warnings = meeting.warnings.map(residentWarning).filter(Boolean);
const availability = agendaAvailability(meeting);
const history = agendaHistory(meeting);
---
<SiteLayout title={meeting.title} description={`Meeting information and agenda for ${meeting.title}`}>
  <section class="meeting-detail-hero"><div class="section-wrap"><a class="back-link" href="/meetings/">← All meetings</a><div class="meeting-title-line"><div><p class="eyebrow">{agency?.name ?? 'Agency information not available'}</p><h1>{meeting.title}</h1>{noticeTopics.length > 0 && <div class="tag-row" aria-label="Meeting notice topics">{noticeTopics.map((topic) => <a class="tag" href={`/topics/${topic.id}/`}>{topic.name}</a>)}</div>}</div><StatusPill label={state} tone={stateTone} /></div><p class="meeting-time">{when} <span class="dot">·</span> {meeting.timezone || 'Local time zone not provided'}</p><div class="meeting-hero-meta"><span>◷ &nbsp;{meeting.location ?? 'Location not yet published'}</span><a href={meeting.officialUrl} target="_blank" rel="noopener noreferrer">Official meeting page ↗</a></div>{warnings.length > 0 && <div class="warning-note">{warnings.map((warning) => <p>{warning}</p>)}</div>}</div></section>
  <section class="section-wrap detail-layout">
    <div class="detail-main">
      <div class="content-heading"><p class="eyebrow">AGENDA AT A GLANCE</p><h2>{items.length ? `${items.length} listed ${items.length === 1 ? 'item' : 'items'}` : availability.heading}</h2>{items.length > 0 && <p>Items are shown in the order published by the agency. A listed item is not a record of a final decision.</p>}</div>
      {items.length > 0 && <fieldset class="agenda-topic-filter" id="agenda-topic-filter"><legend>Filter agenda items by topic</legend>{meetingTopics.length ? <><p class="agenda-filter-help">Select one or more topics; items matching any selected topic are shown.</p><div class="agenda-topic-options">{meetingTopics.map((topic) => <label class="agenda-topic-option"><input type="checkbox" name="topic" value={topic.id} /><span>{topic.name}</span><small>{topicCounts.get(topic.id)}</small></label>)}</div></> : <p class="agenda-filter-empty">No agenda topics are tagged on this meeting.</p>}<div class="agenda-filter-footer"><p id="agenda-filter-count" aria-live="polite">Showing {items.length} of {items.length} agenda items</p><button class="agenda-filter-reset" type="button" id="agenda-filter-reset">All items</button></div><p class="agenda-deep-link-note" id="agenda-deep-link-note" role="status" hidden>The linked agenda item is shown outside the selected topics.</p></fieldset>}
      {items.length ? <div class="agenda-items" id="agenda-items">{items.map((item, index) => { const orderedTopics = itemTopicIds.get(item.id) ?? []; const sourceLink = itemSourceLink(meeting, item); return <details class="agenda-item" id={`item-${item.id}`} data-agenda-item data-item-id={item.id} data-topic-ids={JSON.stringify(orderedTopics)}><summary class="agenda-accordion-summary"><span class="agenda-order"><span>{String(index + 1).padStart(2, '0')}</span>{item.number && <small>#{item.number}</small>}</span><div class="agenda-heading"><div class="agenda-item-title"><h3>{item.title}</h3></div>{item.timeCertain && <span class="time-certain-badge" title={item.timeCertain.quote}>◷ {timeCertainLabel(item)}</span>}{item.section && <span class="agenda-section-name">{item.section}</span>}<div class="agenda-summary-topics" aria-label="Agenda item topics">{orderedTopics.length ? orderedTopics.map((topicId) => <span class="tag">{topicName(topicId)}</span>) : <span class="tag tag-unassigned">Not categorized</span>}</div></div><span class="agenda-disclosure" aria-hidden="true"></span></summary><div class="agenda-item-content">{orderedTopics.length > 0 && <div class="tag-row">{orderedTopics.map((topicId) => <a class="tag" href={`/topics/${encodeURIComponent(topicId)}/`}>{topicName(topicId)}</a>)}</div>}
        {item.timeCertain && <p class="time-certain-source"><strong>{timeCertainLabel(item)}.</strong> The agenda says: <q>{item.timeCertain.quote}</q>{item.timeCertain.page && ` (page ${item.timeCertain.page})`}</p>}
        {sourceLink && <a class="agenda-source-link" href={sourceLink.href} target="_blank" rel="noopener noreferrer">{sourceLink.label} ↗</a>}
        {(item.summary?.status === 'published' ? <div class="summary-block"><div class="summary-label"><span>AGENDA EXCERPT</span></div><p>{item.summary.text}</p><div class="citations">{item.summary.citations.map((citation) => { const doc = sourceDoc(meeting, citation.documentId); const href = citationHref(doc?.url ?? meeting.officialUrl, citation.page, doc?.mediaType); return <details class="citation"><summary><span class="citation-mark" aria-hidden="true">↗</span><span><strong>{doc?.title ?? 'Official source'} · {doc?.mediaType && doc.mediaType !== 'application/pdf' ? 'source section' : 'page'} {citation.page}</strong><small>View cited passage and open source</small></span></summary>{citation.quote ? <q>{citation.quote}</q> : <p class="citation-missing">The quoted passage is unavailable. Open the cited page to review the source.</p>}<a class="citation-open" href={href} target="_blank" rel="noopener noreferrer">Open official source{doc?.mediaType && doc.mediaType !== 'application/pdf' ? '' : ` on page ${citation.page}`} ↗</a></details>; })}</div></div> : item.summary?.status === 'validation_failed' ? <div class="empty-summary"><strong>Summary unavailable</strong><p>See the official source material below.</p></div> : <div class="empty-summary"><strong>Summary unavailable</strong><p>See the official source material below.</p></div>)}
      </div></details>; })}</div> : <div class="empty-panel" data-agenda-availability={availability.kind}><div class="empty-mark">≡</div><div><p>{availability.body}</p>{availability.href && <p><a href={availability.href} target="_blank" rel="noopener noreferrer">{availability.linkText} ↗</a></p>}</div></div>}
      <div class="source-list-block"><div class="content-heading"><p class="eyebrow">OFFICIAL DOCUMENTS</p><h2>Source material</h2></div>{meeting.documents.length ? meeting.documents.map((doc) => <a class="source-document" href={doc.url} target="_blank" rel="noopener noreferrer"><span class="document-icon" aria-hidden="true">↗</span><span><strong>{doc.title}</strong><small>{doc.pageCount} {doc.mediaType && doc.mediaType !== 'application/pdf' ? 'source sections' : 'pages'} · {documentFetchLabel(doc.fetchedAt)} · {documentStatusLabel(doc.status)}</small>{doc.warnings.map(residentWarning).filter(Boolean).map((warning) => <small class="source-warning">{warning}</small>)}</span><span class="source-open">Open official document ↗</span></a>) : <p class="muted-panel">Open the official meeting page for available agenda documents.</p>}</div>
    </div>
    <aside class="detail-aside">
      <section class="aside-card"><p class="eyebrow">ATTEND & PARTICIPATE</p><h2>Participation details</h2><dl class="logistics-list"><div><dt>Location</dt><dd>{meeting.location ?? 'Not published'}</dd></div><div><dt>Remote access</dt><dd>{meeting.participation.remoteUrl || meeting.participation.phone ? <>{meeting.participation.remoteUrl && <a href={meeting.participation.remoteUrl} target="_blank" rel="noopener noreferrer">Join remotely ↗</a>}{meeting.participation.remoteUrl && meeting.participation.phone && <br />}{meeting.participation.phone && <>By phone: {meeting.participation.phone}</>}</> : 'Not published'}</dd></div>{meeting.participation.watchUrl && <div><dt>Watch live</dt><dd><a href={meeting.participation.watchUrl} target="_blank" rel="noopener noreferrer">Livestream ↗</a></dd></div>}<div><dt>Public comment</dt><dd>{meeting.participation.instructions ?? 'Official instructions not available.'}{meeting.participation.email && <><br />Written comment: <a href={`mailto:${meeting.participation.email}`}>{meeting.participation.email}</a></>}</dd></div><div><dt>Deadline</dt><dd>{meeting.participation.deadline ?? 'No deadline stated'}</dd></div></dl><CalendarDownload meeting={meeting} />{meeting.participation.url ? <a class="button button-dark button-full" href={meeting.participation.url} target="_blank" rel="noopener noreferrer">Participation details ↗</a> : <a class="button button-outline button-full" href={meeting.officialUrl} target="_blank" rel="noopener noreferrer">Check agency website ↗</a>}<p class="aside-footnote">{meeting.participation.fromAgenda ? 'Read automatically from the official agenda. ' : ''}Confirm current instructions with the agency.</p></section>
      <section class="aside-card record-card"><p class="eyebrow">AFTER THE MEETING</p><h2>The public record</h2><div class="record-link"><span>Minutes</span>{meeting.minutesUrl ? <a href={meeting.minutesUrl} target="_blank" rel="noopener noreferrer">Read minutes ↗</a> : <span class="record-missing">Not yet available</span>}</div><div class="record-link"><span>Recording</span>{meeting.recordingUrl ? <a href={meeting.recordingUrl} target="_blank" rel="noopener noreferrer">Watch recording ↗</a> : <span class="record-missing">Not yet available</span>}</div></section>
      {history ? <section class="aside-card agenda-history"><p class="eyebrow">AGENDA HISTORY</p><h2>{agendaHistoryHeading(history)}</h2>{history.length > 0 && <ol class="history-list">{history.map((entry) => <li class={`history-${entry.change}`}><time datetime={entry.at}>{formatDate(entry.at, { month: 'short', day: 'numeric', year: 'numeric' })}</time><span>{entry.text}</span></li>)}</ol>}<p class="history-note">{history.length > 0 && 'Dates are when this site first found each version, which can be later than when the agency posted it. '}{sourceCheckLabel(meeting.lastCheckedAt)}.</p></section>
      : <section class="aside-card agenda-history"><p class="eyebrow">SOURCE STATUS</p><h2>Meeting record updated {formatDate(meeting.updatedAt)}</h2><p class="history-note">{sourceCheckLabel(meeting.lastCheckedAt)}.</p></section>}
    </aside>
  </section>
  <script src="../../scripts/meeting-agenda-filter.ts"></script>
  <script src="../../scripts/open-agenda-item.ts"></script>
</SiteLayout>
